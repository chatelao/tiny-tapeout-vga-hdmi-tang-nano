// top.cst - m3_uart_echo
IO_LOC "clk_27m"     45;
IO_PORT "clk_27m"    IO_TYPE=LVCMOS33;

IO_LOC  "led_pin"    10; // LED
IO_PORT "led_pin"    IO_TYPE=LVCMOS33;

IO_LOC  "btn1_pin"   14; // BTN-1
IO_PORT "btn1_pin"   IO_TYPE=LVCMOS18;

IO_LOC  "btn2_pin"   15; // BTN-2
IO_PORT "btn2_pin"   IO_TYPE=LVCMOS18;

IO_LOC  "uart0_rxd"  19; // UART0-RX
IO_PORT "uart0_rxd"  IO_TYPE=LVCMOS33;

IO_LOC  "uart0_txd"  18; // UART0-TX
IO_PORT "uart0_txd"  IO_TYPE=LVCMOS33;

// HDMI/DVI
IO_LOC "tmds_clk_p" 28,27;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;

IO_LOC "tmds_d_p[0]" 30,29;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;

IO_LOC "tmds_d_p[1]" 32,31;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;

IO_LOC "tmds_d_p[2]" 35,34;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8;
